[Unit]
Description=Hourly operator summary and audit loop for Polymarket paper bot
After=polymarket-paper-bot.service

[Service]
Type=oneshot
WorkingDirectory=/root/obsidian-hermes-vault/projects/polymarket-5min-bot
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/root/obsidian-hermes-vault/projects/polymarket-5min-bot/.env
ExecStart=/usr/bin/flock -n /run/polymarket-paper-ops.lock /bin/bash -c '/root/obsidian-hermes-vault/projects/polymarket-5min-bot/.venv/bin/python scripts/ops_status.py --write && /root/obsidian-hermes-vault/projects/polymarket-5min-bot/.venv/bin/python scripts/ops_evidence.py --write && /root/obsidian-hermes-vault/projects/polymarket-5min-bot/.venv/bin/python scripts/ops_settlement_diagnostics.py --write && /root/obsidian-hermes-vault/projects/polymarket-5min-bot/.venv/bin/python scripts/fill_markout_audit.py && /root/obsidian-hermes-vault/projects/polymarket-5min-bot/.venv/bin/python scripts/settlement_latency_audit.py && /root/obsidian-hermes-vault/projects/polymarket-5min-bot/.venv/bin/python scripts/reconcile_metrics_current.py && /root/obsidian-hermes-vault/projects/polymarket-5min-bot/.venv/bin/python scripts/attribution_report.py && /root/obsidian-hermes-vault/projects/polymarket-5min-bot/.venv/bin/python scripts/fill_markout_report.py && /root/obsidian-hermes-vault/projects/polymarket-5min-bot/.venv/bin/python /root/.hermes/scripts/polymarket_telegram_evidence.py --runtime-dir /root/obsidian-hermes-vault/projects/polymarket-5min-bot/data/runtime --send'
TimeoutStartSec=10min
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
MemoryMax=768M
TasksMax=128
StandardOutput=journal
StandardError=journal
